@page
@model VVSummerBlastFRONTEND.Pages.ProfilModel
@{
    ViewData["Title"] = "Profilom";
}

<style>
    .profile-card {
        background: #111;
        border: 1px solid #222;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 0 30px rgba(0, 210, 255, 0.05);
    }

    .order-table {
        background: transparent;
        color: white;
    }

        .order-table th {
            color: #00d2ff;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
            border-bottom: 2px solid #222;
        }

        .order-table td {
            border-bottom: 1px solid #222;
            padding: 15px 0;
        }

    .status-badge {
        background: rgba(0, 255, 153, 0.1);
        color: #00ff99;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    .btn-detail {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 6px;
    }

    /* Modal sötétítése */
    .modal-content {
        box-shadow: 0 0 50px rgba(0, 210, 255, 0.2);
    }
</style>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-4">
            <div class="profile-card text-center">
                <div class="mb-4">
                    <i class="bi bi-person-circle" style="font-size: 5rem; color: #ff007f;"></i>
                </div>
                <h2 id="pName" class="fw-900 mb-1" style="font-weight:900;">...</h2>
                <p id="pRole" class="text-info small fw-bold text-uppercase mb-4">USER</p>

                <div class="text-start bg-dark p-3 rounded-3 mb-4">
                    <div class="small text-secondary fw-bold text-uppercase">Fiók állapota</div>
                    <div class="text-white">Aktív Fesztiválozó <i class="bi bi-check-circle-fill text-success ms-1"></i></div>
                </div>

                <button onclick="kilepes()" class="btn btn-outline-danger w-100 fw-bold">Kijelentkezés</button>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="profile-card">
                <h4 class="fw-900 mb-4 text-uppercase" style="letter-spacing: 2px; font-weight:900;">
                    <i class="bi bi-ticket-detailed me-2 text-info"></i>Rendeléseim
                </h4>

                <div class="table-responsive">
                    <table class="table order-table align-middle">
                        <thead>
                            <tr>
                                <th>Azonosító</th>
                                <th>Dátum</th>
                                <th>Összeg</th>
                                <th>Állapot</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="ordersBody">
                            <tr><td colspan="5" class="text-center py-5 text-secondary">Rendelések betöltése...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Kicsit nagyobb modal (modal-lg) a jobb asztali élményért -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: #0d0d0d; border: 1px solid #00d2ff; border-radius: 15px;">
            <div class="modal-header border-secondary p-4">
                <div>
                    <h5 class="modal-title fw-900 text-uppercase mb-0" id="modalOrderId" style="letter-spacing: 2px;">RENDELÉS #...</h5>
                    <small class="text-secondary fw-bold" id="modalDate">...</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body p-4">
                <!-- Információs panelek -->
                <div class="row g-3 mb-4 text-center text-md-start">
                    <div class="col-6 col-md-3">
                        <div class="bg-dark p-2 rounded border border-secondary h-100">
                            <small class="text-secondary d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Állapot</small>
                            <span class="status-badge d-inline-block mt-1" id="modalStatus">...</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="bg-dark p-2 rounded border border-secondary h-100">
                            <small class="text-secondary d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Fizetési mód</small>
                            <span class="text-white small">Bankkártya</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="bg-dark p-2 rounded border border-secondary h-100 text-md-end">
                            <small class="text-secondary d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Összesen fizetve</small>
                            <span class="text-info fs-4 fw-bold" id="modalTotal">0 Ft</span>
                        </div>
                    </div>
                </div>

                <!-- Tételek listája -->
                <div class="table-responsive">
                    <table class="table table-dark align-middle">
                        <thead class="text-secondary">
                            <tr style="font-size: 0.75rem; border-bottom: 2px solid #222;">
                                <th class="ps-0 py-3">TERMÉK MEGNEVEZÉSE</th>
                                <th class="text-center py-3">MENNYISÉG</th>
                                <th class="text-end pe-0 py-3">RÉSZÖSSZEG</th>
                            </tr>
                        </thead>
                        <tbody id="modalItems" class="border-0">
                            <!-- JS tölti fel -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-outline-secondary fw-bold text-uppercase w-100 py-2" data-bs-dismiss="modal" style="border-radius: 8px; letter-spacing: 1px;">Bezárás</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = "https://localhost:7025";
        let allOrders = [];

        async function loadProfile() {
            const userJson = localStorage.getItem('user');
            if (!userJson) {
                window.location.href = "/Login";
                return;
            }

            const user = JSON.parse(userJson);
            document.getElementById('pName').innerText = user.name;
            document.getElementById('pRole').innerText = user.role;

            try {
                const response = await fetch(`${apiBaseUrl}/api/Rendelesek/user/${user.id}`);
                allOrders = await response.json();

                const tbody = document.getElementById('ordersBody');
                tbody.innerHTML = '';

                if (allOrders.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-5 text-secondary">Még nem vásároltál jegyet.</td></tr>';
                    return;
                }

                allOrders.forEach(o => {
                    tbody.innerHTML += `
                        <tr>
                            <td class="fw-bold">#${o.id}</td>
                            <td class="text-secondary">${o.datum}</td>
                            <td class="fw-bold text-info">${o.vegosszeg.toLocaleString()} Ft</td>
                            <td><span class="status-badge">${o.statusz}</span></td>
                            <td class="text-end">
                                <button onclick="showDetails(${o.id})" class="btn btn-outline-info btn-sm btn-detail">Részletek</button>
                            </td>
                        </tr>`;
                });
            } catch (error) {
                console.error("Hiba:", error);
                document.getElementById('ordersBody').innerHTML = '<tr><td colspan="5" class="text-center text-danger">Hiba történt a betöltéskor.</td></tr>';
            }
        }

                                function showDetails(orderId) {
            const order = allOrders.find(o => o.id === orderId);
            if (!order) return;

            // Alapadatok kitöltése
            document.getElementById('modalOrderId').innerText = `Rendelés #${order.id}`;
            document.getElementById('modalDate').innerText = order.datum;
            document.getElementById('modalStatus').innerText = order.statusz;
            document.getElementById('modalTotal').innerText = `${order.vegosszeg.toLocaleString()} Ft`;

            const itemsBody = document.getElementById('modalItems');
            itemsBody.innerHTML = '';

            // Most már a Backend küldi a rendelesTetelek-et!
            if (order.rendelesTetelek && order.rendelesTetelek.length > 0) {
                order.rendelesTetelek.forEach(t => {
                    const meretSzoveg = (t.meret && t.meret !== "N/A") ? `<br><small class="text-info">MÉRET: ${t.meret}</small>` : "";
            
                    itemsBody.innerHTML += `
                        <tr>
                            <td class="py-2">
                                <span class="d-block fw-bold text-white">${t.termekNev}</span>
                                ${meretSzoveg}
                            </td>
                            <td class="text-center py-2">${t.mennyiseg} db</td>
                            <td class="text-end py-2 text-info">${(t.egysegar * t.mennyiseg).toLocaleString()} Ft</td>
                        </tr>`;
                });
            } else {
                itemsBody.innerHTML = '<tr><td colspan="3" class="text-center py-3 text-secondary">Nincsenek megjeleníthető tételek.</td></tr>';
            }

            const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', loadProfile);
    </script>
}