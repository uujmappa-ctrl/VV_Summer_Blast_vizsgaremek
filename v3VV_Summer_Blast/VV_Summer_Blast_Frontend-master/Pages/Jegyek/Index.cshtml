@page
@model VVSummerBlastFRONTEND.Pages.Jegyek.IndexModel
@{
    ViewData["Title"] = "Jegyvásárlás";
}

<script>
    document.body.classList.add('home-body-override');
</script>

<style>
    .jegyek-page { background: #050505; min-height: 100vh; color: white; font-family: 'Montserrat', sans-serif; padding-bottom: 80px; }
    .jegyek-hero { background: #050505; padding: 60px 0 40px; text-align: center; border-bottom: 1px solid #111; }
    .jegyek-hero h1 { font-size: clamp(3rem, 8vw, 6rem); font-weight: 900; text-transform: uppercase; color: #ffffff; text-shadow: 4px 4px 0px #ff007f, 8px 8px 0px #00d2ff; }
    .jegyek-hero p { font-size: 1rem; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: #FFD700; margin: 0; }
    
    .jegyek-content { padding-top: 50px; }
    
    .jegy-kartya { background: #0d0d0d; border: 1px solid #1a1a1a; border-radius: 16px; padding: 28px; text-align: center; transition: 0.3s ease; height: 100%; display: flex; flex-direction: column; }
    .jegy-kartya:hover { transform: translateY(-8px); border-color: #00d2ff; box-shadow: 0 0 30px rgba(0, 210, 255, 0.15); }
    
    .jegy-tag { display: inline-block; font-size: 0.65rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; padding: 4px 12px; border-radius: 20px; margin-bottom: 16px; border: 1px solid #00d2ff; color: #00d2ff; }
    .jegy-nev { font-weight: 800; font-size: 1.1rem; margin-bottom: 10px; text-transform: uppercase; }
    .jegy-ar { font-size: 2.2rem; font-weight: 900; color: #00d2ff; margin-bottom: 20px; }
    .jegy-ar span { font-size: 1rem; opacity: 0.6; }
    .jegy-features { list-style: none; padding: 0; margin: 0 0 24px; text-align: left; font-size: 0.82rem; color: #888; flex: 1; }
    
    .btn-kosar { display: block; width: 100%; padding: 12px; font-size: 0.85rem; font-weight: 900; text-transform: uppercase; color: #050505; background: #00d2ff; border: none; border-radius: 8px; cursor: pointer; transition: 0.3s ease; }
    
    /* Hamarosan gomb stílusa: szürke és nem kattintható */
    .btn-kosar:disabled { 
        background: #333 !important; 
        color: #666 !important; 
        cursor: not-allowed; 
        box-shadow: none !important;
        transform: none !important;
    }
</style>

<div class="jegyek-page">
    <div class="jegyek-hero">
        <h1>Jegyek & Bérletek</h1>
        <p>VV Summer Blast 2026 · Sopron</p>
    </div>

    <div class="jegyek-content">
        <div class="container">
            <div class="row g-4 justify-content-center">
                @if (Model.Jegyek != null && Model.Jegyek.Any())
                {
                    @foreach (var j in Model.Jegyek)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="jegy-kartya">
                                <span class="jegy-tag">@(j.Tipus == "Jegy" ? "Belépő" : "Termék")</span>
                                <div class="jegy-nev">@j.Nev</div>
                                <div class="jegy-ar">@j.Ar.ToString("N0") <span>Ft</span></div>
                                
                                <ul class="jegy-features">
                                    <li>✅ Érvényes: 2026</li>
                                    <li>✅ VV Summer Blast belépés</li>
                                </ul>

                                @* Minden gomb deaktiválva, Hamarosan felirattal *@
                                <button class="btn-kosar" disabled>
                                    Hamarosan
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <p>Jelenleg nincs betöltött jegy az adatbázisban.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
