@page
@model VVSummerBlastFRONTEND.Pages.Idorend.IndexModel
@{
    ViewData["Title"] = "Időrend";

    var napNevek = new Dictionary<string, string>
    {
        { "2026-07-02", "Július 2. – Csütörtök" },
        { "2026-07-03", "Július 3. – Péntek" },
        { "2026-07-04", "Július 4. – Szombat" }
    };

    var napSzinek = new Dictionary<string, string>
    {
        { "2026-07-02", "#00d2ff" },
        { "2026-07-03", "#ff007f" },
        { "2026-07-04", "#FFD700" }
    };

    var mufajSzinek = new Dictionary<string, string>
    {
        { "pop", "#00d2ff" },
        { "rap", "#ff007f" },
        { "rock", "#FFD700" },
        { "indie", "#b388ff" },
        { "alternativ", "#69ff47" },
        { "elektronikus", "#00d2ff" },
        { "hiphop", "#ff007f" },
    };
}

<script>
    document.body.classList.add('home-body-override');
</script>

<style>
    .idorend-page {
        background: #050505;
        min-height: 100vh;
        color: white;
        font-family: 'Montserrat', sans-serif;
    }

    .idorend-hero {
        background: #050505;
        padding: 60px 0 40px;
        text-align: center;
        border-bottom: 1px solid #111;
    }

        .idorend-hero h1 {
            font-size: clamp(3rem, 8vw, 6rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -2px;
            color: #ffffff;
            text-shadow: 4px 4px 0px #ff007f, 8px 8px 0px #00d2ff;
        }

        .idorend-hero p {
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #FFD700;
            margin: 0;
        }

    /* --- ÚJ SZŰRŐ GOMBOK STÍLUSA --- */
    .filter-section {
        background-color: #050505;
        padding: 20px 0 30px;
    }

    .filter-btn {
        display: inline-block;
        padding: 10px 24px;
        border-radius: 30px;
        border: 2px solid #00d2ff;
        color: #00d2ff;
        background: transparent;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .filter-btn:hover {
            background-color: #00d2ff;
            color: #050505;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.6);
        }

        .filter-btn.active-filter {
            background-color: #00d2ff;
            color: #050505;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.5);
        }
    /* ------------------------------ */

    .idorend-content {
        padding: 20px 0 80px;
    }

    .nap-szekció {
        margin-bottom: 60px;
    }

    .nap-header {
        padding: 20px 30px;
        border-radius: 14px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .nap-header h2 {
            font-size: 1.1rem;
            font-weight: 900;
            letter-spacing: 5px;
            text-transform: uppercase;
            margin: 0;
            color: #050505;
        }

        .nap-header .nap-szam {
            font-size: 2.5rem;
            font-weight: 900;
            color: rgba(0,0,0,0.15);
            line-height: 1;
        }

    .esemeny-lista {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .esemeny-kartya {
        background: #0d0d0d;
        border-radius: 12px;
        padding: 18px 24px;
        display: grid;
        grid-template-columns: 90px 1fr auto;
        align-items: center;
        gap: 20px;
        border: 1px solid #1a1a1a;
        border-left: 4px solid #00d2ff;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .esemeny-kartya:hover {
            transform: translateX(6px);
            background: #151515;
            box-shadow: 0 0 30px rgba(0, 210, 255, 0.1);
        }

    .esemeny-ido {
        text-align: center;
    }

        .esemeny-ido .kezdes {
            font-size: 1.4rem;
            font-weight: 900;
            color: white;
            line-height: 1;
        }

        .esemeny-ido .elvalaszto {
            font-size: 0.7rem;
            color: white;
        }

        .esemeny-ido .vege {
            font-size: 1.4rem;
            font-weight: 900;
            color: white;
            line-height: 1;
        }

    .esemeny-info h3 {
        font-size: 1.1rem;
        font-weight: 800;
        color: white;
        margin: 0 0 4px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .esemeny-info .szinpad {
        font-size: 0.8rem;
        color: white;
    }

    .mufaj-badge {
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        white-space: nowrap;
        border: 1px solid;
        background: transparent;
    }

    .idopont-elvalaszto {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 20px 0 14px;
    }

        .idopont-elvalaszto span {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 3px;
            color: #ff007f;
            white-space: nowrap;
            text-transform: uppercase;
        }

        .idopont-elvalaszto::before,
        .idopont-elvalaszto::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #1a1a1a;
        }

    .ures-uzenet {
        text-align: center;
        padding: 80px 20px;
        color: #333;
        font-size: 0.9rem;
        letter-spacing: 3px;
        text-transform: uppercase;
    }
</style>

<div class="idorend-page">
    <div class="idorend-hero">
        <h1>Időrend</h1>
        <p>VV Summer Blast 2026 · Sopron</p>
    </div>

    <div class="filter-section">
        <div class="container text-center">
            <div class="d-flex justify-content-center flex-wrap gap-3">
                <a asp-page="./Index" asp-route-mufaj=""
                       class="filter-btn @(string.IsNullOrEmpty(Model.Mufaj) ? "active-filter" : "")">
                    ÖSSZES
                </a>
                
                @if (Model.Mufajok != null && Model.Mufajok.Any())
                {
                    @foreach (var m in Model.Mufajok)
                    {
                        <a asp-page="./Index" asp-route-mufaj="@m"
                               class="filter-btn @(Model.Mufaj == m ? "active-filter" : "")">
                            @m
                        </a>
                    }
                }
            </div>
        </div>
    </div>
    <div class="idorend-content">
        <div class="container">
            @if (!Model.NapiProgram.Any())
            {
                <div class="ures-uzenet">
                    <p>Jelenleg nincs a szűrésnek megfelelő esemény.</p>
                </div>
            }
            else
            {
                string? elozo_idopont = null;

                @foreach (var nap in Model.NapiProgram.OrderBy(n => n.Key))
                {
                    var napNev = napNevek.ContainsKey(nap.Key) ? napNevek[nap.Key] : nap.Key;
                    var napSzin = napSzinek.ContainsKey(nap.Key) ? napSzinek[nap.Key] : "#00d2ff";
                    var napSorszam = nap.Key == "2026-07-02" ? "01" : nap.Key == "2026-07-03" ? "02" : "03";

                    <div class="nap-szekció">
                        <div class="nap-header" style="background: @napSzin;">
                            <h2>@napNev</h2>
                            <span class="nap-szam">@napSorszam</span>
                        </div>

                        <div class="esemeny-lista">
                            @{
                                elozo_idopont = null;
                            }
                            @foreach (var esemeny in nap.Value)
                            {
                                var idopontStr = esemeny.Kezdes.ToString("HH:mm");
                                var mufaj = esemeny.Eloado?.Mufaj?.ToLower() ?? "";
                                var szin = mufajSzinek.ContainsKey(mufaj) ? mufajSzinek[mufaj] : "#444";

                                if (elozo_idopont != null && elozo_idopont != idopontStr)
                                {
                                    <div class="idopont-elvalaszto">
                                        <span>@idopontStr</span>
                                    </div>
                                }
                                elozo_idopont = idopontStr;

                                <div class="esemeny-kartya" style="border-left-color: @szin;">
                                    <div class="esemeny-ido">
                                        <div class="kezdes">@esemeny.Kezdes.ToString("HH:mm")</div>
                                        <div class="elvalaszto">↓</div>
                                        <div class="vege">@esemeny.Vege.ToString("HH:mm")</div>
                                    </div>
                                    <div class="esemeny-info">
                                        <h3>@esemeny.Eloado?.Nev</h3>
                                        <div class="szinpad">📍 @esemeny.Szinpad?.Nev</div>
                                    </div>
                                    <span class="mufaj-badge" style="color: @szin; border-color: @szin;">
                                        @esemeny.Eloado?.Mufaj
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>