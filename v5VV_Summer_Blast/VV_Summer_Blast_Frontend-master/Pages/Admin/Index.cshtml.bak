@page
@model VVSummerBlastFRONTEND.Pages.Admin.FelhasznalokModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Felhasználók";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 style="font-weight: 900; letter-spacing: 1px;">Regisztrált Fesztiválozók</h2>
        <p class="text-secondary mb-0">Felhasználók listája, admin jogok kiadása és tiltások.</p>
    </div>

    <div style="width: 300px;">
        <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-secondary">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" id="keresoMezo" class="form-control bg-dark text-white border-secondary" placeholder="Keresés név vagy email alapján..." onkeyup="keresesFuttatasa()">
        </div>
    </div>
</div>

<div class="admin-card">
    <table class="table table-dark table-hover align-middle mb-0" id="usersTable">
        <thead>
            <tr style="color: #00d2ff;">
                <th scope="col">ID</th>
                <th scope="col">Név</th>
                <th scope="col">Email</th>
                <th scope="col">Regisztráció ideje</th>
                <th scope="col">Jogosultság</th>
                <th scope="col" class="text-end">Műveletek</th>
            </tr>
        </thead>
        <tbody id="usersTableBody">
            <tr>
                <td colspan="6" class="text-center text-secondary py-4">
                    <div class="spinner-border text-info spinner-border-sm me-2" role="status"></div>
                    Felhasználók betöltése...
                </td>
            </tr>
        </tbody>
    </table>
    <div id="noResultMsg" class="text-center text-secondary py-4" style="display: none;">
        <i class="bi bi-emoji-frown fs-3 d-block mb-2"></i>
        Nincs a keresésnek megfelelő felhasználó.
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = "https://localhost:7025"; // Ellenőrizd a portot!
        let osszesFelhasznalo = []; // Ide mentjük el az adatokat a keresőhöz

        // --- 1. FELHASZNÁLÓK BETÖLTÉSE ---
        async function felhasznalokBetoltese() {
            try {
                const response = await fetch(`${apiBaseUrl}/api/Felhasznalok`);
                osszesFelhasznalo = await response.json();

                tablaRendereles(osszesFelhasznalo);
            } catch (error) {
                console.error("Hiba a felhasználók betöltésekor:", error);
                document.getElementById('usersTableBody').innerHTML = `<tr><td colspan="6" class="text-center text-danger py-4">Hiba történt az adatok betöltésekor!</td></tr>`;
            }
        }

        // --- 2. TÁBLÁZAT KIRAJZOLÁSA ---
        function tablaRendereles(usersData) {
            const tbody = document.getElementById('usersTableBody');
            const noResult = document.getElementById('noResultMsg');
            const table = document.getElementById('usersTable');

            tbody.innerHTML = '';

            if (usersData.length === 0) {
                table.style.display = 'none';
                noResult.style.display = 'block';
                return;
            }

            table.style.display = 'table';
            noResult.style.display = 'none';

            usersData.forEach(u => {
                // Gyönyörű neon badge-ek a jogokhoz
                let roleBadge = u.role === 'Admin'
                    ? `<span class="badge" style="background: linear-gradient(45deg, #FFD700, #FFA500); color: #000; font-weight: 900; letter-spacing: 1px; box-shadow: 0 0 10px rgba(255,215,0,0.4);">ADMIN</span>`
                    : `<span class="badge bg-secondary" style="letter-spacing: 1px;">USER</span>`;

                // Dinamikus gombok
                let roleBtn = u.role === 'Admin'
                    ? `<button class="btn btn-sm btn-outline-warning me-2" onclick="jogosultsagValtas(${u.id})" title="Lefokozás User-ré"><i class="bi bi-arrow-down-circle"></i></button>`
                    : `<button class="btn btn-sm btn-outline-success me-2" onclick="jogosultsagValtas(${u.id})" title="Előléptetés Admin-ná"><i class="bi bi-arrow-up-circle"></i></button>`;

                // Mester Admin védelem (A vvAdmin@gmail.com érinthetetlen)
                let isMasterAdmin = u.email.toLowerCase() === "vvadmin@gmail.com";
                let actionButtons = isMasterAdmin
                    ? `<span class="badge bg-dark border border-warning text-warning" style="padding: 8px;"><i class="bi bi-shield-lock-fill"></i> Mester Fiók</span>`
                    : `${roleBtn} <button class="btn btn-sm btn-outline-danger" onclick="felhasznaloTorlese(${u.id}, '${u.userName}')" title="Végleges Törlés"><i class="bi bi-trash"></i></button>`;

                tbody.innerHTML += `
                    <tr>
                        <td class="text-secondary">#${u.id}</td>
                        <td class="" style="color: #fff;">${u.userName}</td>
                        <td class="text-info">${u.email}</td>
                        <td class="text-secondary" style="font-size: 0.85rem;">${u.createdAt}</td>
                        <td>${roleBadge}</td>
                        <td class="text-end">${actionButtons}</td>
                    </tr>
                `;
            });
        }

        // --- 3. ÉLŐ KERESŐ FUNKCIÓ ---
        function keresesFuttatasa() {
            const searchText = document.getElementById('keresoMezo').value.toLowerCase();

            // Szűrjük a lementett tömböt név vagy email alapján
            const szurtLista = osszesFelhasznalo.filter(u =>
                u.userName.toLowerCase().includes(searchText) ||
                u.email.toLowerCase().includes(searchText)
            );

            // Újrarajzoljuk a táblázatot a szűrt adatokkal
            tablaRendereles(szurtLista);
        }

        // --- 4. JOGOSULTSÁG VÁLTÁSA ---
        async function jogosultsagValtas(id) {
            if(confirm("Biztosan meg akarod változtatni ennek a felhasználónak a jogosultságát?")) {
                try {
                    const response = await fetch(`${apiBaseUrl}/api/Felhasznalok/${id}/role`, { method: 'PUT' });
                    if (response.ok) {
                        felhasznalokBetoltese(); // Frissítés
                    } else { alert("Hiba történt a jogosultság módosításakor."); }
                } catch (error) { alert("Nem sikerült csatlakozni a szerverhez."); }
            }
        }

        // --- 5. TÖRLÉS ---
        async function felhasznaloTorlese(id, nev) {
            if(confirm(`VÉGLEGES TÖRLÉS: Biztosan ki akarod tiltani a(z) ${nev} nevű felhasználót a rendszerből?`)) {
                try {
                    const response = await fetch(`${apiBaseUrl}/api/Felhasznalok/${id}`, { method: 'DELETE' });
                    if (response.ok) {
                        felhasznalokBetoltese();
                    } else {
                        const errorData = await response.json();
                        alert(errorData.message || "Hiba történt a törlés során.");
                    }
                } catch (error) { alert("Nem sikerült csatlakozni a szerverhez."); }
            }
        }

        // Indítás
        document.addEventListener('DOMContentLoaded', felhasznalokBetoltese);
    </script>
}