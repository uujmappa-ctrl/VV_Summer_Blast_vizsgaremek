<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VV Summer Blast</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/png" href="~/favicon.png">

    <style>
        :root {
            --vv-neon-blue: #00d2ff;
            --vv-neon-pink: #ff007f;
            --vv-dark-bg: #050505;
        }

        body {
            background-color: var(--vv-dark-bg) !important;
            color: #ffffff;
            font-family: 'Montserrat', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
        }

        main {
            flex: 1 0 auto;
        }

        .festival-navbar {
            background: rgba(5, 5, 5, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0, 210, 255, 0.2);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            transition: all 0.3s ease;
        }

        .festival-logo {
            display: flex;
            align-items: center;
            font-size: 1.8rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -1px;
            text-decoration: none;
            line-height: 1;
        }

        .logo-icon {
            color: #FFD700;
            margin-right: 8px;
            font-size: 1.8rem;
            filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.6));
        }

        .logo-vv { color: #ffffff; }
        .logo-summer { color: var(--vv-neon-blue); margin: 0 4px; text-shadow: 0 0 10px rgba(0, 210, 255, 0.4); }
        .logo-blast { color: var(--vv-neon-pink); text-shadow: 0 0 10px rgba(255, 0, 127, 0.4); }

        .nav-link-custom {
            color: #e0e0e0 !important;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            transition: 0.3s ease;
        }

        .nav-link-custom:hover {
            color: var(--vv-neon-blue) !important;
            text-shadow: 0px 0px 10px rgba(0, 210, 255, 0.5);
            transform: translateY(-2px);
        }

        .dropdown-menu-dark-custom {
            background-color: rgba(15, 15, 15, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 210, 255, 0.2);
            border-radius: 10px;
        }

        .dropdown-menu-dark-custom .dropdown-item {
            color: #e0e0e0;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
        }

        .dropdown-menu-dark-custom .dropdown-item:hover {
            background-color: rgba(0, 210, 255, 0.1);
            color: var(--vv-neon-blue);
        }

        .auth-container-nav { display: flex; align-items: center; }
        #userMenu { display: none; align-items: center; gap: 12px; }

        @@media (min-width: 992px) {
            .auth-container-nav {
                margin-left: 15px;
                padding-left: 15px;
                border-left: 1px solid rgba(255, 255, 255, 0.1);
            }
        }

        @@media (max-width: 991px) {
            .auth-container-nav {
                margin-top: 15px;
                padding-top: 15px;
                border-top: 1px solid rgba(255, 255, 255, 0.1);
                justify-content: center;
                width: 100%;
            }

            #userMenu {
                flex-wrap: wrap;
                justify-content: center;
                text-align: center;
            }
        }

        .nav-welcome {
            color: var(--vv-neon-blue);
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .nav-btn-login {
            background: linear-gradient(90deg, var(--vv-neon-blue), var(--vv-neon-pink));
            color: white !important;
            padding: 8px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.85rem;
            transition: 0.3s;
            display: inline-block;
        }

        .nav-btn-logout {
            background: transparent;
            color: var(--vv-neon-pink);
            border: 1px solid var(--vv-neon-pink);
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.75rem;
            cursor: pointer;
        }

        .footer {
            background: #050505;
            border-top: 1px solid rgba(0, 210, 255, 0.3);
            padding: 50px 0 30px 0;
            margin-top: auto;
        }

        .sponsor-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 40px;
            margin-bottom: 30px;
            padding: 40px;
            background: linear-gradient(90deg, #4b0082, #8a2be2); 
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(75, 0, 130, 0.4);
        }

        .sponsor-logo {
            max-height: 40px;
            width: auto;
            filter: grayscale(1) brightness(0) invert(1);
            transition: all 0.3s ease-in-out;
            opacity: 0.6; 
        }

        .sponsor-logo:hover {
            opacity: 1; 
            transform: scale(1.1);
            filter: grayscale(1) brightness(0) invert(1) drop-shadow(0 0 8px rgba(255, 255, 255, 0.8));
        }

        .slogan-row {
            display: block;
            font-size: clamp(1.2rem, 4vw, 2rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 5px;
            margin: 30px 0;
            background: linear-gradient(90deg, #ff007f, #00d2ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .footer-bottom-text {
            color: #555;
            font-size: 0.8rem;
            letter-spacing: 2px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark festival-navbar sticky-top py-3">
        <div class="container">
            <a class="navbar-brand festival-logo" href="/">
                <i class="bi bi-lightning-charge-fill logo-icon"></i>
                <span class="logo-vv">VV</span>
                <span class="logo-summer">SUMMER</span>
                <span class="logo-blast">BLAST</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center gap-2">
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-link-custom dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Program</a>
                        <ul class="dropdown-menu dropdown-menu-dark-custom">
                            <li><a class="dropdown-item" href="/Eloadok">Fellépők</a></li>
                            <li><a class="dropdown-item" href="/Idorend">Időrend</a></li>
                        </ul>
                    </li>

                    <li class="nav-item"><a class="nav-link nav-link-custom" href="/Jegyek">Jegyek</a></li>

                    <li class="nav-item dropdown">
                        <a class="nav-link nav-link-custom dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Szállások</a>
                        <ul class="dropdown-menu dropdown-menu-dark-custom">
                            <li><a class="dropdown-item" href="/Kemping">Kemping</a></li>
                            <li><a class="dropdown-item" href="/Hostel">Hostel</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link nav-link-custom dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Termékek</a>
                        <ul class="dropdown-menu dropdown-menu-dark-custom">
                            <li><a class="dropdown-item" href="/Termekek/Index">Összes termék</a></li>
                            <li><a class="dropdown-item" href="/Termekek/Index?kategoria=ruhazat">Pólók / Merch</a></li>
                            <li><a class="dropdown-item" href="/Termekek/Index?kategoria=kiegeszito">Kiegészítők</a></li>
                        </ul>
                    </li>

                    <li class="nav-item"><a class="nav-link nav-link-custom" href="https://www.vasvill.hu/">Best Of Vasvilla</a></li>

                   
                </ul>

                <div class="auth-container-nav">
                    <div id="guestMenu">
                        <a href="/Login" class="nav-btn-login">Belépés</a>
                    </div>

                    <div id="userMenu">
                        <a href="/Profil" class="nav-link nav-link-custom p-0">Profilom</a>
                        <span id="welcomeText" class="nav-welcome"></span>
                        <button onclick="kilepes()" class="nav-btn-logout">Kilépés</button>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container text-center">
            <h5 class="text-uppercase mb-4" style="color: var(--vv-neon-blue); font-size: 0.8rem; letter-spacing: 4px; font-weight: 900;">Hivatalos Partnereink</h5>

            <div class="sponsor-container">
                <a href="https://www.coca-cola.com/hu/hu" target="_blank"> <img src="/Images/Coca-Cola-logo.png" alt="Coca-Cola" class="sponsor-logo"></a>
                <a href="https://www.finlandia.com/hu" target="_blank"> <img src="/Images/finlandia.png" alt="Finlandia" class="sponsor-logo"> </a>
                <a href="https://radio1.hu/" target="_blank"> <img src="/Images/radio1.png" alt="Rádió 1" class="sponsor-logo"> </a>
                <a href="https://www.redbull.com/hu-hu" target="_blank"> <img src="/Images/redbull.png" alt="RedBull" class="sponsor-logo"> </a>
                <a href="https://www.tatratea.com/" target="_blank"> <img src="/Images/tatratea.png" alt="TatraTea" class="sponsor-logo"> </a>
                <a href="http://www.sopron.hu/" target="_blank"> <img src="/Images/sopron.svg" alt="Sopron" class="sponsor-logo"> </a>
                <a href="https://www.telekom.hu/lakossagi" target="_blank"> <img src="/Images/telekom.svg" alt="Telekom" class="sponsor-logo"> </a>
                <a href="https://fagus.adventorhotels.hu/" target="_blank"> <img src="/Images/fagus_hotel.svg" alt="Fagus" class="sponsor-logo"> </a>
            </div>

            <p class="footer-bottom-text mt-4">
                &copy; 2026 VV SUMMER BLAST - SOPRON
                <br /><br />
                <span class="slogan-row">Feel the Energy, Own the Night</span>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const API_URL = "https://localhost:7025/api/Kosar";

        function ellenorizKosar(event) {
            const user = getLoggedInUser();
            if (!user) {
                alert("Kérlek, jelentkezz be a kosár tartalmának megtekintéséhez!");
            } else {
                window.location.href = "/Kosar/Index";
            }
        }

        function getLoggedInUser() {
            const userJson = localStorage.getItem('user');
            return userJson ? JSON.parse(userJson) : null;
        }

        async function kosarFrissitBadge() {
            const user = getLoggedInUser();
            const badge = document.getElementById('kosar-badge');

            if (!user) {
                if (badge) badge.style.display = 'none';
                return;
            }

            try {
                const response = await fetch(`${API_URL}/${user.id}`);
                if (response.ok) {
                    const kosarElemek = await response.json();
                    const osszesen = kosarElemek.reduce((sum, item) => sum + item.mennyiseg, 0);

                    if (badge) {
                        badge.textContent = osszesen;
                        badge.style.display = osszesen > 0 ? 'flex' : 'none';
                    }
                }
            } catch (error) {
                console.error("Hiba a kosár jelvény frissítésekor:", error);
            }
        }

        function frissitAuthMenu() {
            const user = getLoggedInUser();
            const guestMenu = document.getElementById('guestMenu');
            const userMenu = document.getElementById('userMenu');
            const welcomeText = document.getElementById('welcomeText');

            if (user) {
                if (guestMenu) guestMenu.style.display = 'none';
                if (userMenu) userMenu.style.display = 'flex';
                if (welcomeText) welcomeText.innerText = `Szia, ${user.name}!`;
            } else {
                if (guestMenu) guestMenu.style.display = 'block';
                if (userMenu) userMenu.style.display = 'none';
            }
        }

        function kilepes() {
            localStorage.removeItem('user');
            window.location.href = '/';
        }

        document.addEventListener('DOMContentLoaded', () => {
            frissitAuthMenu();
            kosarFrissitBadge();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>