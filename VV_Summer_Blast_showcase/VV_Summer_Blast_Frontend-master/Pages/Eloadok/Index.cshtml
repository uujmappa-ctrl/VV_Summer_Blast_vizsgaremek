@page
@model VVSummerBlastFRONTEND.Pages.Eloadok.IndexModel
@{
    ViewData["Title"] = "Fellépők";
}

<script>
    document.body.classList.add('home-body-override');
</script>

<style>
    .eloadok-hero {
        background: #050505;
        padding: 60px 0 40px;
        text-align: center;
    }

        .eloadok-hero h1 {
            font-size: clamp(3rem, 8vw, 6rem);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -2px;
            color: #ffffff;
            text-shadow: 4px 4px 0px #ff007f, 8px 8px 0px #00d2ff;
        }

        .eloadok-hero p {
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #FFD700;
        }

    /* Itt vannak a műfaj szűrő gombok */
    .filter-section {
        background-color: #050505;
        padding: 10px 0 30px;
    }

    .filter-btn {
        display: inline-block;
        padding: 10px 24px;
        border-radius: 30px; 
        border: 2px solid #00d2ff;
        color: #00d2ff;
        background: transparent;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .filter-btn:hover {
            background-color: #00d2ff; 
            color: #050505; 
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.6); 
        }

        /* Jelezzük, ha épp ki van választva egy kategória */
        .filter-btn.active-filter {
            background-color: #00d2ff;
            color: #050505;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.5);
        }

    /* A fellépők rácsos elrendezése */
    .eloadok-grid {
        background-color: #050505;
        padding: 20px 0 80px;
    }

    .eloado-card {
        background: #111;
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #222;
    }

        /* Ha az egérrel rásiklunk, picit megemelkedik a kártya */
        .eloado-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 0 30px rgba(0, 210, 255, 0.3);
            border-color: #00d2ff;
        }

        .eloado-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            filter: grayscale(30%); /* Alapból picit fakóbb... */
            transition: filter 0.3s ease;
        }

        .eloado-card:hover img {
            filter: grayscale(0%); /* ...de hoverre kiszínesedik */
        }

    .eloado-card-body {
        padding: 20px;
        background: #111;
    }

        .eloado-card-body h4 {
            font-size: 1.2rem;
            font-weight: 900;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 6px;
        }

        .eloado-card-body p {
            font-size: 0.82rem;
            color: #888;
            margin-bottom: 14px;
        }

    .mufaj-tag {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #00d2ff;
        border: 1px solid #00d2ff;
        padding: 3px 10px;
        border-radius: 20px;
        margin-bottom: 14px;
    }

    .btn-reszletek {
        display: block;
        width: 100%;
        padding: 10px;
        font-size: 0.85rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #050505;
        background-color: #00d2ff;
        border: none;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .btn-reszletek:hover {
            background-color: #ff007f;
            color: white;
            box-shadow: 0 0 20px rgba(255, 0, 127, 0.5);
        }

    .ures-uzenet {
        text-align: center;
        padding: 60px;
        color: #555;
    }

    /* Innentől jön a modal design */
    .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85); 
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .modal-backdrop.active {
            display: flex;
        }

    .modal-panel {
        background: #111;
        border: 1px solid #222;
        border-radius: 20px;
        width: 100%;
        max-width: 1200px;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        animation: modalIn 0.25s ease; 
    }

    @@keyframes modalIn {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-close {
        position: absolute;
        top: 16px;
        right: 16px;
        background: #1a1a1a;
        border: 1px solid #333;
        color: #aaa;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        z-index: 10;
    }

        .modal-close:hover {
            background: #ff007f;
            border-color: #ff007f;
            color: white;
        }

    .modal-body {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 0;
        align-items: stretch;
        min-height: 500px;
    }

    .modal-img {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #000;
    }

        .modal-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            position: absolute;
            top: 0;
            left: 0;
        }

    .modal-info {
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #0a0a0a;
    }

    .modal-badge {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .modal-badge .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ff007f;
        }

        .modal-badge .label {
            font-size: 0.72rem;
            color: #ffffff;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

    .modal-nev {
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -1px;
        color: #fff;
        line-height: 1.1;
    }

    .modal-divider {
        height: 2px;
        background: linear-gradient(90deg, #00d2ff, #ff007f, transparent);
        border: none;
    }

    .modal-leiras {
        font-size: 0.9rem;
        color: #aaa;
        line-height: 1.8;
        flex: 1;
    }

    .modal-loading {
        padding: 80px;
        text-align: center;
        color: #555;
        font-size: 0.85rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* Mobilon egymás alá kerülnek a modal dolgai */
    @@media (max-width: 600px) {
        .modal-body {
            grid-template-columns: 1fr;
        }

        .modal-img {
            border-radius: 20px 20px 0 0;
        }

            .modal-img img {
                min-height: 220px;
            }
    }

    .modal-button-container {
        margin-top: auto;
        display: flex;
        justify-content: center;
        padding-top: 20px;
    }
</style>

<div class="eloadok-hero">
    <h1>FELLÉPŐK</h1>
    <p>VV Summer Blast 2026 · Sopron</p>
</div>

<div class="filter-section">
    <div class="container text-center">
        <div class="d-flex justify-content-center flex-wrap gap-3">
            @* Az összes gomb visszavisz az alap listához szűrés nélkül *@
            <a asp-page="./Index" asp-route-mufaj=""
                   class="filter-btn @(string.IsNullOrEmpty(Model.Mufaj) ? "active-filter" : "")">
                ÖSSZES
            </a>
            
            @* Ha vannak műfajaink, akkor kilistázzuk őket gombokként *@
            @if (Model.Mufajok != null && Model.Mufajok.Any())
            {
                @foreach (var m in Model.Mufajok)
                {
                    <a asp-page="./Index" asp-route-mufaj="@m"
                           class="filter-btn @(Model.Mufaj == m ? "active-filter" : "")">
                        @m
                    </a>
                }
            }
        </div>
    </div>
</div>

<div class="eloadok-grid">
    <div class="container">
        <div class="row g-4 justify-content-center">
            @* Itt pörgetjük ki az előadók kártyáit *@
            @if (Model.Eloadok != null && Model.Eloadok.Any())
            {
                @foreach (var item in Model.Eloadok)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="eloado-card">
                            <img src="@item.KepUrl" alt="@item.Nev">
                            <div class="eloado-card-body">
                                <span class="mufaj-tag">@item.Mufaj</span>
                                <h4>@item.Nev</h4>
                                <p>@item.Leiras</p>
                                @* Ez hívja meg a JS-t a modalhoz *@
                                <button class="btn-reszletek" onclick="megnyitModal(@item.Id)">Részletek →</button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="ures-uzenet">
                    <p>Hamarosan...</p>
                </div>
            }
        </div>
    </div>
</div>

@* Ez a rész marad üresen alapból, a JS tölti fel adatokkal *@
<div class="modal-backdrop" id="eloadoModal" onclick="backdropKattintas(event)">
    <div class="modal-panel" id="modalPanel">
        <button class="modal-close" onclick="bezarModal()">✕</button>
        <div id="modalTartalom">
            <div class="modal-loading">Betöltés...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Megnézzük honnan kell szedni az adatokat
        const apiBaseUrl = '@Html.Raw(ViewData["BackendBaseUrl"] ?? "https://localhost:7025")'.replace(/\/+$/, "");

        // Ezzel húzzuk be az adatokat az API-ból a felugró ablakhoz
        async function megnyitModal(id) {
            const modal = document.getElementById('eloadoModal');
            const tartalom = document.getElementById('modalTartalom');

            if (!modal || !tartalom) return;

            tartalom.innerHTML = '<div class="modal-loading">Betöltés...</div>';
            modal.classList.add('active');
            document.body.style.overflow = 'hidden'; // Ne görögjön a háttér, ha nyitva a modal

            try {
                const response = await fetch(`${apiBaseUrl}/api/Eloadok/${id}`);
                if (!response.ok) throw new Error('Hiba a betöltés során');
                const e = await response.json();

                // Ha van Spotify link, akkor csinálunk belőle egy kis lejátszót
                let spotifyHtml = "";
                if (e.spotifyUrl) {
                    const embedUrl = e.spotifyUrl.split('?')[0]
                                               .replace("track/", "embed/track/")
                                               .replace("artist/", "embed/artist/");

                    spotifyHtml = `
                        <div style="margin-top:15px; background:#111; border-radius:12px; overflow:hidden; border:1px solid #222;">
                            <iframe style="border-radius:12px"
                                src="${embedUrl}"
                                width="100%" height="80"
                                frameBorder="0"
                                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                                loading="lazy">
                            </iframe>
                        </div>`;
                }

                // Itt rakjuk össze a modal belsejét
                tartalom.innerHTML = `
                    <div class="modal-body">
                        <div class="modal-img">
                            <img src="${e.kepUrl}" alt="${e.nev}" />
                        </div>
                        <div class="modal-info">
                            <div class="modal-badge">
                                <span class="dot" style="background: white !important;"></span>
                                <span class="label" style="color: white !important;">Fellépő · 2026</span>
                            </div>
                            <h2 class="modal-nev">${e.nev}</h2>
                            <hr class="modal-divider" />
                            <span class="mufaj-tag">${e.mufaj}</span>
                            <p class="modal-leiras">${e.bio || e.leiras || "Nincs leírás."}</p>
                            ${spotifyHtml}
                            <div class="modal-button-container">
                                <a href="/Jegyek" style="display:inline-block; padding:12px 24px; background:#ff007f; color:white; border-radius:8px; text-decoration:none; font-weight:900; letter-spacing:1px;">Jegyvásárlás</a>
                            </div>
                        </div>
                    </div>`;
            } catch (err) {
                tartalom.innerHTML = '<div class="modal-loading">Hiba történt a betöltés során.</div>';
            }
        }

        // Modal bezárása és alaphelyzetbe állítása
        function bezarModal() {
            const modal = document.getElementById('eloadoModal');
            const tartalom = document.getElementById('modalTartalom');

            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = '';

                if (tartalom) {
                    tartalom.innerHTML = '';
                }
            }
        }

        // Ha a szürke részre kattintunk, záródjon be
        function backdropKattintas(event) {
            if (event.target === document.getElementById('eloadoModal')) {
                bezarModal();
            }
        }

        // Esc gombra is záródjon, ne kelljen egerezni
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') bezarModal();
        });
    </script>
}