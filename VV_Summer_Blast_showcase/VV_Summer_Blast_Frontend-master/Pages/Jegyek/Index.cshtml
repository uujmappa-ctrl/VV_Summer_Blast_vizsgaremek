@page
@model VVSummerBlastFRONTEND.Pages.Jegyek.IndexModel
@{
    ViewData["Title"] = "Jegyvásárlás";
}

<script>
    document.body.classList.add('home-body-override');
</script>

<style>
    .jegyek-page {
        background: #050505;
        min-height: 100vh;
        color: white;
        font-family: 'Montserrat', sans-serif;
        /* Ez adja meg a térközt az utolsó kártyák alá */
        padding-bottom: 80px; 
    }

    .jegyek-hero {
        background: #050505;
        padding: 60px 0 40px;
        text-align: center;
        border-bottom: 1px solid #111;
    }

    .jegyek-hero h1 {
        font-size: clamp(3rem, 8vw, 6rem);
        font-weight: 900;
        text-transform: uppercase;
        color: #ffffff;
        text-shadow: 4px 4px 0px #ff007f, 8px 8px 0px #00d2ff;
    }

    .jegyek-hero p {
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #FFD700;
        margin: 0;
    }

    .filter-bar {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .filter-btn {
        background: transparent;
        border: 2px solid #333;
        color: #888;
        padding: 8px 20px;
        border-radius: 30px;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .filter-btn:hover, .filter-btn.active {
        border-color: #00d2ff;
        color: #fff;
    }

    .filter-btn.active {
        background: #00d2ff;
        color: #050505;
        box-shadow: 0 0 15px rgba(0, 210, 255, 0.4);
    }

    .filter-btn.kemping.active {
        background: #00ff99;
        border-color: #00ff99;
        box-shadow: 0 0 15px rgba(0, 255, 153, 0.4);
    }

    /* Kategória specifikus vizuális elválasztók */
    .kategoria-cim {
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 5px;
        text-transform: uppercase;
        margin: 50px 0 20px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .category-group {
        margin-bottom: 40px;
    }

    .category-group[data-cat="napi"] .kategoria-cim { color: #00d2ff; }
    .category-group[data-cat="napi"] .kategoria-cim::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, #00d2ff, transparent); }

    .category-group[data-cat="vip"] .kategoria-cim { color: #ff007f; }
    .category-group[data-cat="vip"] .kategoria-cim::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, #ff007f, transparent); }

    .category-group[data-cat="berlet"] .kategoria-cim { color: #FFD700; }
    .category-group[data-cat="berlet"] .kategoria-cim::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, #FFD700, transparent); }

    .category-group[data-cat="kemping"] .kategoria-cim { color: #00ff99; }
    .category-group[data-cat="kemping"] .kategoria-cim::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, #00ff99, transparent); }

    .jegy-kartya {
        background: #0d0d0d;
        border: 1px solid #1a1a1a;
        border-radius: 16px;
        padding: 28px;
        text-align: center;
        transition: 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .jegy-kartya:hover {
        transform: translateY(-8px);
        border-color: #00d2ff;
        box-shadow: 0 0 30px rgba(0, 210, 255, 0.15);
    }

    .jegy-tag {
        display: inline-block; font-size: 0.65rem; font-weight: 700; letter-spacing: 3px;
        text-transform: uppercase; padding: 4px 12px; border-radius: 20px; margin-bottom: 16px;
        border: 1px solid #00d2ff; color: #00d2ff;
    }

    .jegy-ar { font-size: 2.2rem; font-weight: 900; color: #00d2ff; margin-bottom: 20px; }
    .jegy-ar span { font-size: 1rem; opacity: 0.6; }

    .jegy-features {
        list-style: none; padding: 0; margin: 0 0 24px; text-align: left;
        font-size: 0.82rem; color: #888; flex: 1;
    }

    .btn-kosar {
        display: block; width: 100%; padding: 12px; font-size: 0.85rem; font-weight: 900;
        text-transform: uppercase; color: #050505; background: #00d2ff; border: none;
        border-radius: 8px; cursor: pointer; transition: 0.3s ease;
    }
</style>

<div class="jegyek-page">
    <div class="jegyek-hero">
        <h1>Jegyek & Bérletek</h1>
        <p>VV Summer Blast 2026 · Sopron</p>

        <div class="filter-bar">
            <button class="filter-btn active" onclick="filterJegyek('all', this)">Összes</button>
            <button class="filter-btn" onclick="filterJegyek('napi', this)">Napijegyek</button>
            <button class="filter-btn" onclick="filterJegyek('vip', this)">VIP</button>
            <button class="filter-btn" onclick="filterJegyek('berlet', this)">Bérletek</button>
            <button class="filter-btn kemping" onclick="filterJegyek('kemping', this)">Kemping</button>
        </div>
    </div>

    <div class="jegyek-content">
        <div class="container">
            @{
                // Backendről érkező adatok szétválogatása kulcsszavak alapján
                var kempingKulcsszavak = new[] { "Igloo", "Sátor", "Karaván", "Parcella" };
                var kempingJegyek = Model.Jegyek.Where(j => kempingKulcsszavak.Any(k => j.Nev.Contains(k))).ToList();
                var vipjegyek = Model.Jegyek.Where(j => j.Nev.Contains("VIP") && !j.Nev.Contains("bérlet") && !kempingKulcsszavak.Any(k => j.Nev.Contains(k))).ToList();
                var berletek = Model.Jegyek.Where(j => j.Nev.Contains("bérlet") && !kempingKulcsszavak.Any(k => j.Nev.Contains(k))).ToList();
                var napijegyek = Model.Jegyek.Where(j => !j.Nev.Contains("VIP") && !j.Nev.Contains("bérlet") && !j.Nev.Contains("Diák") && !kempingKulcsszavak.Any(k => j.Nev.Contains(k))).ToList();
            }

            @if (napijegyek.Any())
            {
                <div class="category-group" data-cat="napi">
                    <div class="kategoria-cim">Napijegyek</div>
                    <div class="row g-4 justify-content-center">
                        @foreach (var j in napijegyek)
                        {
                            <div class="col-md-4">
                                <div class="jegy-kartya">
                                    <span class="jegy-tag">Napijegy</span>
                                    <div class="jegy-nev">@j.Nev</div>
                                    <div class="jegy-ar">@j.Ar.ToString("N0") <span>Ft</span></div>
                                    <ul class="jegy-features"><li>✅ Napi belépő</li><li>✅ Minden színpad</li></ul>
                                    <button class="btn-kosar" onclick="prepAdd(@j.Id, '@Html.Raw(j.Nev)')">Kosárba</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (vipjegyek.Any())
            {
                <div class="category-group" data-cat="vip">
                    <div class="kategoria-cim">VIP Jegyek</div>
                    <div class="row g-4 justify-content-center">
                        @foreach (var j in vipjegyek)
                        {
                            <div class="col-md-4">
                                <div class="jegy-kartya vip" style="border-color: #ff007f;">
                                    <span class="jegy-tag vip" style="color: #ff007f; border-color: #ff007f;">VIP</span>
                                    <div class="jegy-nev">@j.Nev</div>
                                    <div class="jegy-ar vip" style="color: #ff007f;">@j.Ar.ToString("N0") <span>Ft</span></div>
                                    <ul class="jegy-features"><li>✨ VIP Terasz</li><li>✨ Külön beléptetés</li></ul>
                                    <button class="btn-kosar vip" style="background: #ff007f;" onclick="prepAdd(@j.Id, '@Html.Raw(j.Nev)')">Kosárba</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (berletek.Any())
            {
                <div class="category-group" data-cat="berlet">
                    <div class="kategoria-cim">Bérletek</div>
                    <div class="row g-4 justify-content-center">
                        @foreach (var j in berletek)
                        {
                            <div class="col-md-4">
                                <div class="jegy-kartya berlet" style="border-color: #FFD700;">
                                    <span class="jegy-tag berlet" style="color: #FFD700; border-color: #FFD700;">Bérlet</span>
                                    <div class="jegy-nev">@j.Nev</div>
                                    <div class="jegy-ar berlet" style="color: #FFD700;">@j.Ar.ToString("N0") <span>Ft</span></div>
                                    <ul class="jegy-features"><li>🎟️ Összes napra</li><li>✅ Soron kívüli bejutás</li></ul>
                                    <button class="btn-kosar berlet" style="background: #FFD700;" onclick="prepAdd(@j.Id, '@Html.Raw(j.Nev)')">Kosárba</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (kempingJegyek.Any())
            {
                <div class="category-group" data-cat="kemping">
                    <div class="kategoria-cim kemping">Kemping & Szállás</div>
                    <div class="row g-4 justify-content-center">
                        @foreach (var j in kempingJegyek)
                        {
                            <div class="col-md-4">
                                <div class="jegy-kartya kemping" style="border-color: #00ff99;">
                                    <span class="jegy-tag kemping" style="color: #00ff99; border-color: #00ff99;">Szállás</span>
                                    <div class="jegy-nev">@j.Nev</div>
                                    <div class="jegy-ar kemping" style="color: #00ff99;">@j.Ar.ToString("N0") <span>Ft</span></div>
                                    <ul class="jegy-features"><li>🏕️ Kemping belépés</li><li>🚿 Zuhanyzó használat</li></ul>
                                    <button class="btn-kosar kemping" style="background: #00ff99;" onclick="prepAdd(@j.Id, '@Html.Raw(j.Nev)')">Kosárba</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Szerveroldali adatok szerializálása JS használathoz
        const jegyAdatok = @Html.Raw(Json.Serialize(Model.Jegyek));

        /**
         * Kliensoldali kategória szűrés a DOM elemek láthatóságának módosításával
         */
        function filterJegyek(category, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            
            if (btn) {
                btn.classList.add('active');
            } else {
                const targetBtn = document.querySelector(`.filter-btn[onclick*="'${category}'"]`);
                if(targetBtn) targetBtn.classList.add('active');
            }

            const groups = document.querySelectorAll('.category-group');
            groups.forEach(group => {
                group.style.display = (category === 'all' || group.getAttribute('data-cat') === category) ? 'block' : 'none';
            });
        }

        // URL paraméterek alapján történő kezdeti szűrés
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const filterParam = urlParams.get('filter');

            if (filterParam) {
                filterJegyek(filterParam, null);
            }
        });

        /**
         * Kosárba helyezés előkészítése: variáns azonosítása az adatstruktúrában
         */
        function prepAdd(termekId, nev) {
            const termek = jegyAdatok.find(t => t.id === termekId || t.Id === termekId);
            if (termek?.variansok?.length > 0) {
                const vId = termek.variansok[0].id || termek.variansok[0].Id;
                kosarbaRak(vId, nev, 1);
            } else {
                console.error("Data integrity error: No variants found for product", termekId);
                alert("Hiba: Ez a termék jelenleg nem érhető el.");
            }
        }

        /**
         * Kosár API hívás aszinkron kezelése
         */
        async function kosarbaRak(vId, nev, db) {
            const userJson = localStorage.getItem('user');
            if (!userJson) {
                alert("A vásárláshoz bejelentkezés szükséges.");
                return;
            }
            const user = JSON.parse(userJson);

            const payload = {
                FelhasznaloId: parseInt(user.id),
                TermekVariansId: parseInt(vId),
                Mennyiseg: parseInt(db)
            };

            try {
                const response = await fetch('https://localhost:7025/api/Kosar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    alert(`${nev} hozzáadva a kosárhoz.`);
                    if(typeof window.kosarFrissitBadge === 'function') window.kosarFrissitBadge();
                } else {
                    alert("A művelet sikertelen. Próbálja újra később.");
                }
            } catch (err) {
                console.error("Cart API unreachable", err);
                alert("Hálózati hiba: A szerver nem válaszol.");
            }
        }
    </script>
}